{
  "$schema": "https://www.getbifrost.ai/schema",
  "encryption_key": "env.BIFROST_ENCRYPTION_KEY",
  "client": {
    "enable_logging": true
  },
  "config_store": {
    "enabled": true,
    "type": "postgres",
    "config": {
      "host": "db",
      "port": "5432",
      "user": "bifrost",
      "password": "env.PG_PASSWORD",
      "db_name": "bifrost",
      "ssl_mode": "disable"
    }
  },
  "logs_store": {
    "enabled": true,
    "type": "postgres",
    "config": {
      "host": "db",
      "port": "5432",
      "user": "bifrost",
      "password": "env.PG_PASSWORD",
      "db_name": "bifrost",
      "ssl_mode": "disable"
    },
    "retention_days": 90
  },
  "providers": {
    "opencode-go": {
      "keys": [
        {
          "name": "opencode-go",
          "value": "env.OPENCODE_GO_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "http://opencode-go:8787",
        "allow_private_network": true
      }
    }
  }
}
