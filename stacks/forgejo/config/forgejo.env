# server
FORGEJO__server__DOMAIN=forge.trkm.io
FORGEJO__server__ROOT_URL=https://forge.trkm.io
FORGEJO__server__SSH_DOMAIN=forge.trkm.io
FORGEJO__server__SSH_PORT=22
FORGEJO__server__SSH_LISTEN_PORT=2222
FORGEJO__server__START_SSH_SERVER=true
FORGEJO__server__LFS_START_SERVER=true
FORGEJO__server__OFFLINE_MODE=true

# database
FORGEJO__database__DB_TYPE=postgres
FORGEJO__database__HOST=db:5432
FORGEJO__database__NAME=forgejo
FORGEJO__database__USER=forgejo
FORGEJO__database__SSL_MODE=disable

# queue
FORGEJO__queue__TYPE=redis
FORGEJO__queue__CONN_STR=redis://cache:6379/0

# cache
FORGEJO__cache__ADAPTER=redis
FORGEJO__cache__HOST=redis://cache:6379/0

# session
FORGEJO__session__PROVIDER=redis
FORGEJO__session__PROVIDER_CONFIG=redis://cache:6379/0

# service
FORGEJO__service__DISABLE_REGISTRATION=true
FORGEJO__service__ENABLE_NOTIFY_MAIL=true
FORGEJO__service__DEFAULT_KEEP_EMAIL_PRIVATE=true
FORGEJO__service__NO_REPLY_ADDRESS=noreply.forge.trkm.io
FORGEJO__service__ALLOW_ONLY_EXTERNAL_REGISTRATION=true
FORGEJO__service__ENABLE_INTERNAL_SIGNIN=false
FORGEJO__service__ENABLE_BASIC_AUTHENTICATION=false

# oauth2_client
FORGEJO__oauth2_client__ENABLE_AUTO_REGISTRATION=true
FORGEJO__oauth2_client__REGISTER_EMAIL_CONFIRM=false
FORGEJO__oauth2_client__UPDATE_AVATAR=true
FORGEJO__oauth2_client__ACCOUNT_LINKING=login

# mailer
FORGEJO__mailer__ENABLED=true
FORGEJO__mailer__SMTP_ADDR=smtp.protonmail.ch
FORGEJO__mailer__SMTP_PORT=587
FORGEJO__mailer__FROM=Forgejo <noreply@trkm.io>
FORGEJO__mailer__USER=noreply@trkm.io

# openid
FORGEJO__openid__ENABLE_OPENID_SIGNIN=false
FORGEJO__openid__ENABLE_OPENID_SIGNUP=false
